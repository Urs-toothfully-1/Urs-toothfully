# Database — Neon or Supabase PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/toothfully?sslmode=require"

# JWT — must be at least 64 characters, random, unique per environment
JWT_SECRET="replace-this-with-a-minimum-64-character-random-secret-string-for-production"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLINIC_NAME="Ur's Toothfully"
NEXT_PUBLIC_DEFAULT_ADVANCE_PERCENT="20"

# Email (Gmail SMTP) — create an App Password at https://myaccount.google.com/apppasswords
SMTP_USER="clinic@gmail.com"
SMTP_APP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM_NAME="Ur's Toothfully"
# Where the daily automated DB backup (/api/cron/backup) is emailed. Defaults to SMTP_USER if unset.
BACKUP_EMAIL_TO=""

# WhatsApp provider: "share" (device share sheet / wa.me) or "cloud-api" (future Meta Cloud API)
WHATSAPP_PROVIDER="share"

# WhatsApp Cloud API module
# Optional dedicated key for encrypting the Meta access token at rest (falls back to JWT_SECRET)
WHATSAPP_TOKEN_KEY=""
# Optional bearer secret allowing an external cron to POST /api/whatsapp/queue (drains retries)
WHATSAPP_CRON_SECRET=""

# Cloudflare Turnstile (public intake bot protection) — leave empty to disable on LAN kiosks
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
